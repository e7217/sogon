# ====================================
# SOGON Docker Environment Configuration
# ====================================

# === Required API Keys (choose one) ===
# Option 1: Groq API (recommended for cloud transcription)
GROQ_API_KEY=your-groq-api-key-here

# Option 2: OpenAI API (alternative)
OPENAI_API_KEY=your-openai-api-key-here

# === Transcription Provider ===
# Options: groq, openai, stable-whisper (GPU required)
TRANSCRIPTION_PROVIDER=groq

# === Translation Provider ===
# Options: openai, azure, anthropic
TRANSLATION_PROVIDER=openai

# === Processing Settings ===
MAX_WORKERS=4
MAX_CHUNK_SIZE_MB=24
MAX_PROCESSING_TIMEOUT_SECONDS=1800

# === Audio Settings ===
AUDIO_QUALITY=64k
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# === Logging ===
API_LOG_LEVEL=INFO

# === Optional: Local Whisper Settings (GPU mode only) ===
# Uncomment these lines if using local Whisper with GPU
# SOGON_LOCAL_MODEL_NAME=large-v3
# SOGON_LOCAL_DEVICE=cuda
# SOGON_LOCAL_COMPUTE_TYPE=float16
